# Meeting Scribe backend'inin adresi. Boş bırakılırsa arayüzle aynı origin'e
# istek atılır (ör. reverse proxy arkasında ikisi aynı domain'deyse).
# A4000'e SSH tüneli veya PAM üzerinden port yönlendirmesi açıldığında
# buraya o adresi yaz, örn: http://127.0.0.1:18000
VITE_MEETING_SCRIBE_API_URL=

# Gizli API anahtarını VITE_ değişkenine koymayın; tarayıcıya gömülür.
# X-API-Key yalnızca sunucu tarafındaki ters proxy'de eklenmelidir.
